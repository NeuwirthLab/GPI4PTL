prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: GPI4PTL
Description: GASPI communication library with Portals4 support
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lGPI2
Libs.private: @ac_lib_portals4@ @ac_lib_infiniband@ @ac_lib_ofi@ @ac_lib_mpi@ -lrt -pthread
